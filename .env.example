# Скопировать в .env и заполнить реальными значениями.
# Полный список полей — app/db/config.py (Settings).

# --- База данных ---
# Локально/через docker-compose: postgresql+asyncpg://app:app@db:5432/app
# (docker-compose.yml переопределяет этот параметр сам).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# SSL для managed Postgres (напр. Timeweb): disable | require | verify-ca | verify-full
# Для локального контейнера оставить пустым.
DB_SSL=
DB_SSL_ROOT_CERT=

# --- Auth / JWT ---
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Email (SMTP) — сброс пароля ---
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Хранилище файлов ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads

# --- Приложение ---
APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Публичный адрес бэкенда — используется для абсолютных ссылок на документы.
BASE_URL=http://localhost:8000

# --- Telegram-алерты (опционально, для ERROR/WARNING логов) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- OpenAI: эмбеддинги и чат ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64
CHAT_MODEL=gpt-4o-mini

# --- Очередь (Celery/Redis) — индексация документов ---
# Локально/через docker-compose: redis://redis:6379/0
# (docker-compose.yml переопределяет этот параметр сам).
REDIS_URL=redis://localhost:6379/0

# --- Диалог / RAG ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
CHAT_HISTORY_LIMIT=10
